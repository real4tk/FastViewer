<!-- Control styles shared by every look. Colours, fonts, corner radii and icon line width are DynamicResources
     that the chosen look (Looks.<Id>.xaml, applied by Looks.cs) fills in, so switching looks is instant. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:fv="clr-namespace:FastViewer;assembly=FastViewer">

  <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <!-- Keyboard focus (Tab in Settings): a rounded ring around the control, like Windows 11. Only shown when
       the keyboard moved the focus, never on mouse clicks. -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource TextMain}" CornerRadius="7" SnapsToDevicePixels="True" fv:Anim.Appear="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons: one template, a translucent layer shows on hover. -->  <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
    <Grid>
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Control}"/>
      <Border x:Name="Hover" Background="{DynamicResource HoverFill}" CornerRadius="{DynamicResource Radius.Control}" Opacity="0"/>
      <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="0.5"/>
        <Setter TargetName="Cp" Property="Opacity" Value="0.75"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.35"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- The same, with the hover layer fading in (83 ms) and out (150 ms) like Windows 11. Used unless
       Settings > Appearance > Animations is Off (Motion.cs picks the template as "Tpl.Button"). -->
  <ControlTemplate x:Key="ButtonTemplateAnimated" TargetType="Button">
    <Grid>
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Control}"/>
      <Border x:Name="Hover" Background="{DynamicResource HoverFill}" CornerRadius="{DynamicResource Radius.Control}" Opacity="0"/>
      <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083"/></Storyboard></BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Cp" Property="Opacity" Value="0.75"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.35"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Subtle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template" Value="{DynamicResource Tpl.Button}"/>
    <Setter Property="Foreground" Value="{DynamicResource ControlText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="40"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource ControlHoverText}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Filled" TargetType="Button" BasedOn="{StaticResource Subtle}">
    <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>

  <!-- A button that must read as a button in every look, also the ones that draw plain buttons without a box
       (Cancel in a dialog, the button in a message, a key box): the look's OutlineEdge is always visible. -->
  <Style x:Key="Outlined" TargetType="Button" BasedOn="{StaticResource Filled}">
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineEdge}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource Filled}">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Subtle}">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="36"/>
    <Setter Property="Padding" Value="8,0"/>
  </Style>

  <Style x:Key="FilledSmall" TargetType="Button" BasedOn="{StaticResource Filled}">
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>

  <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource Subtle}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="36"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
  </Style>

  <Style x:Key="NavArrow" TargetType="Button" BasedOn="{StaticResource Subtle}">
    <Setter Property="Width" Value="32"/>
    <Setter Property="MinWidth" Value="22"/>
    <Setter Property="Height" Value="56"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="Background" Value="{DynamicResource ArrowBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArrowEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Play/pause in the middle of a video: a soft see-through square, as in Photos. -->
  <Style x:Key="CenterPlay" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Width" Value="80"/>
    <Setter Property="Height" Value="80"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bg" CornerRadius="{DynamicResource Radius.Center}" Background="{DynamicResource CenterBg}"
                    BorderBrush="{DynamicResource CenterEdge}" BorderThickness="1"/>
            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CenterHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Cp" Property="Opacity" Value="0.8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- On/off switch for the settings page ("On" label on the left, like Windows). -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="Label" Text="Off" Width="32" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
            <Grid Width="40" Height="20">
              <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SwitchEdge}" Background="{DynamicResource SwitchTrack}"/>
              <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource SwitchKnob}" HorizontalAlignment="Left" Margin="4,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobMove"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Label" Property="Text" Value="On"/>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SwitchOnEdge}"/>
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SwitchKnobOn}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Width" Value="14"/>
              <Setter TargetName="Knob" Property="Height" Value="14"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin scrollbar -->
  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="T" Width="4" CornerRadius="2" Background="{DynamicResource ScrollThumb}" HorizontalAlignment="Center"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="T" Property="Width" Value="6"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window caption buttons (square, close turns red). -->
  <ControlTemplate x:Key="CaptionTemplate" TargetType="Button">
    <Grid Background="{TemplateBinding Background}">
      <Border x:Name="Hover" Background="{TemplateBinding Tag}" Opacity="0"/>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="0.7"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="CaptionTemplateAnimated" TargetType="Button">
    <Grid Background="{TemplateBinding Background}">
      <Border x:Name="Hover" Background="{TemplateBinding Tag}" Opacity="0"/>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083"/></Storyboard></BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="0.7"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Caption" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template" Value="{DynamicResource Tpl.Caption}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Tag" Value="{DynamicResource CaptionHover}"/>
  </Style>

  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
    <Setter Property="Tag" Value="{DynamicResource CloseHover}"/>
  </Style>

  <!-- Slider: thin track, accent fill, round thumb with accent dot. -->
  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Accent}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderRest" TargetType="RepeatButton" BasedOn="{StaticResource SliderFill}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource SliderRestFill}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="20" Height="20" Background="Transparent">
            <Ellipse Fill="{DynamicResource SliderThumbBg}" Stroke="{DynamicResource SliderThumbEdge}" StrokeThickness="1"/>
            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><ScaleTransform x:Name="DotScale"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.17" Duration="0:0:0.1"/>
                  <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.17" Duration="0:0:0.1"/>
                </Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Dot" Property="Width" Value="10"/>
              <Setter TargetName="Dot" Property="Height" Value="10"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FluentSlider" TargetType="Slider">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="24" Background="Transparent">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderFill}"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderRest}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus and tooltips -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border x:Name="MenuRoot" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Float}" Padding="4" MinWidth="220">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" Height="36" Padding="12,0" Margin="0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource TextDim}" FontSize="12"
                         Margin="24,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small grey section title inside a menu (not clickable) -->
  <Style x:Key="MenuHeading" TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <ContentPresenter ContentSource="Header" Margin="12,6,12,2" TextElement.Foreground="{DynamicResource TextDim}" TextElement.FontSize="12"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource MenuEdge}" Margin="-4,3"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource TipBg}" BorderBrush="{DynamicResource TipEdge}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Control}" Padding="8,5,8,6">
            <ContentPresenter TextElement.Foreground="{DynamicResource TextMain}" TextElement.FontSize="12" TextElement.FontFamily="{DynamicResource Font.Ui}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Text boxes (the custom look's name, a colour's code): the look's control colours, an accent line while typing -->
  <Style x:Key="SettingsTextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlEdge}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="2,0" CornerRadius="1" Background="{DynamicResource Accent}" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Line" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style></ResourceDictionary>
