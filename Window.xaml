<!-- Window layout, laid out like the Windows Photos viewer: command bar on top, file details at the bottom.
     Colours, fonts and corner radii come from the chosen look (DynamicResource), icons are Glyphs (Looks.cs). -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fv="clr-namespace:FastViewer;assembly=FastViewer"
      xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
      Background="{DynamicResource WindowBg}" UseLayoutRounding="True"
      TextElement.Foreground="{DynamicResource TextMain}" TextElement.FontFamily="{DynamicResource Font.Ui}" TextElement.FontSize="14">
  <Grid.RowDefinitions>
    <RowDefinition x:Name="TopRow" Height="48"/>
    <RowDefinition Height="*"/>
    <RowDefinition x:Name="BottomRow" Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Top command bar (doubles as the title bar) -->
  <Grid x:Name="TopBar" Background="{DynamicResource TopBarBg}">
    <!-- Hit-testable (FastViewer.cs drags the window from it) so a shortened name can show in full as a tooltip -->
    <TextBlock x:Name="TitleText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
               TextTrimming="CharacterEllipsis" MaxWidth="560" Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <StackPanel x:Name="TopLeft" Orientation="Horizontal" HorizontalAlignment="Left" Margin="14,0,0,0">
      <Button x:Name="OpenBtn" Style="{StaticResource Filled}" Margin="0,0,12,0" ToolTip="Open (Ctrl+O)">
        <StackPanel Orientation="Horizontal">
          <fv:Glyph Code="&#xE8E5;" Size="15"/>
          <TextBlock x:Name="OpenLabel" Text="Open" Margin="10,0,2,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button x:Name="DeleteBtn" Style="{StaticResource Subtle}" Margin="0,0,4,0" ToolTip="Delete (Delete)">
        <fv:Glyph Code="&#xE74D;"/>
      </Button>
      <Button x:Name="CopyBtn" Style="{StaticResource Subtle}" Margin="0,0,4,0" ToolTip="Copy (Ctrl+C)">
        <fv:Glyph Code="&#xE8C8;"/>
      </Button>
      <Button x:Name="RotateBtn" Style="{StaticResource Subtle}" Margin="0,0,4,0" ToolTip="Rotate (Ctrl+R)">
        <fv:Glyph Code="&#xE7AD;"/>
      </Button>
      <Button x:Name="MoreBtn" Style="{StaticResource Subtle}" ToolTip="See more">
        <fv:Glyph Code="&#xE712;"/>
      </Button>
    </StackPanel>
    <StackPanel x:Name="TopRight" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="MiniBtn" Style="{StaticResource Subtle}" Margin="0,0,6,0" ToolTip="Mini player: just the video, always on top (Ctrl+M)">
        <fv:Glyph Code="&#xE944;"/>
      </Button>
      <Button x:Name="OpenWithBtn" Style="{StaticResource Filled}" Margin="0,0,14,0" ToolTip="Open with another app">
        <StackPanel Orientation="Horizontal">
          <fv:Glyph x:Name="OpenWithIcon" Code="&#xE7AC;" Visibility="Collapsed"/>
          <TextBlock x:Name="OpenWithLabel" Text="Open with" VerticalAlignment="Center"/>
          <fv:Glyph x:Name="OpenWithChevron" Code="&#xE70D;" Size="10" Margin="12,2,0,0"/>
        </StackPanel>
      </Button>
      <Button x:Name="MinBtn" Style="{StaticResource Caption}" ToolTip="Minimize">
        <fv:Glyph Code="&#xE921;" Size="10"/>
      </Button>
      <Button x:Name="MaxBtn" Style="{StaticResource Caption}" ToolTip="Maximize">
        <fv:Glyph x:Name="MaxIcon" Code="&#xE922;" Size="10"/>
      </Button>
      <Button x:Name="CloseBtn" Style="{StaticResource CaptionClose}" ToolTip="Close">
        <fv:Glyph Code="&#xE8BB;" Size="10"/>
      </Button>
    </StackPanel>
  </Grid>

  <!-- Viewing area -->
  <Grid x:Name="ViewArea" Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="InfoCol" Width="0"/>
    </Grid.ColumnDefinitions>

    <Grid x:Name="Stage" Background="{DynamicResource StageBg}" ClipToBounds="True"/>

    <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
      <TextBlock x:Name="Message" Foreground="{DynamicResource TextSecondary}" FontSize="16" TextAlignment="Center"
                 TextWrapping="Wrap" IsHitTestVisible="False"/>
      <!-- A file FastViewer can't open: offer another app -->
      <Button x:Name="MessageBtn" Style="{StaticResource Filled}" Height="32" Margin="0,18,0,0" HorizontalAlignment="Center"
              Content="Open with another app" Visibility="Collapsed"/>
    </StackPanel>

    <Grid x:Name="Overlay">
      <!-- Darkens the video slightly while the controls are showing, like Photos -->
      <Rectangle x:Name="Scrim" Fill="{DynamicResource ScrimFill}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
      <Button x:Name="PrevBtn" Style="{StaticResource NavArrow}" HorizontalAlignment="Left" Margin="8,0,0,0" ToolTip="Previous (Left arrow)">
        <fv:Glyph Code="&#xEDD9;" Size="8"/>
      </Button>
      <Button x:Name="NextBtn" Style="{StaticResource NavArrow}" HorizontalAlignment="Right" Margin="0,0,8,0" ToolTip="Next (Right arrow)">
        <fv:Glyph Code="&#xEDDA;" Size="8"/>
      </Button>

      <Button x:Name="CenterPlayBtn" Style="{StaticResource CenterPlay}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Path x:Name="PlayGlyph" Data="M0,0 L28,16 L0,32 Z" Fill="White" Stroke="White" StrokeThickness="2.5"
                StrokeLineJoin="Round" Margin="5,0,0,0"/>
          <StackPanel x:Name="PauseGlyph" Orientation="Horizontal">
            <Rectangle Width="8" Height="30" RadiusX="2.5" RadiusY="2.5" Fill="White"/>
            <Rectangle Width="8" Height="30" RadiusX="2.5" RadiusY="2.5" Fill="White" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </Button>

      <StackPanel x:Name="MiniBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Visibility="Collapsed">
        <!-- Settings > Buttons > Volume button in the mini player (off unless switched on) -->
        <Button x:Name="MiniVolBtn" Style="{StaticResource NavArrow}" Width="32" Height="32" Margin="0,0,4,0" Visibility="Collapsed">
          <fv:Glyph x:Name="MiniVolIcon" Code="&#xE995;" Size="13"/>
        </Button>
        <Button x:Name="MiniExitBtn" Style="{StaticResource NavArrow}" Width="32" Height="32" Margin="0,0,4,0" ToolTip="Back to full window (Ctrl+M or double-click)">
          <fv:Glyph Code="&#xE8A7;" Size="13"/>
        </Button>
        <Button x:Name="MiniCloseBtn" Style="{StaticResource NavArrow}" Width="32" Height="32" ToolTip="Close">
          <fv:Glyph Code="&#xE8BB;" Size="11"/>
        </Button>
      </StackPanel>

      <!-- Floating video controls -->
      <Border x:Name="Transport" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Width="640"
              Background="{DynamicResource FloatBg}" BorderBrush="{DynamicResource FloatEdge}" BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Float}" Padding="4,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="PlayBtn" Style="{StaticResource Transport}" ToolTip="Play / Pause (Space)">
            <fv:Glyph x:Name="PlayIcon" Code="&#xE769;"/>
          </Button>
          <!-- Skip buttons: a circular arrow with the number of seconds (set in Settings) inside -->
          <Button x:Name="BackBtn" Grid.Column="1" Style="{StaticResource Transport}">
            <Grid Width="20" Height="20">
              <fv:Glyph Code="&#xE72C;" Size="18" RenderTransformOrigin="0.5,0.5">
                <fv:Glyph.RenderTransform>
                  <ScaleTransform ScaleX="-1"/>
                </fv:Glyph.RenderTransform>
              </fv:Glyph>
              <TextBlock x:Name="BackText" FontSize="7.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
            </Grid>
          </Button>
          <Button x:Name="FwdBtn" Grid.Column="2" Style="{StaticResource Transport}">
            <Grid Width="20" Height="20">
              <fv:Glyph Code="&#xE72C;" Size="18"/>
              <TextBlock x:Name="FwdText" FontSize="7.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
            </Grid>
          </Button>
          <Button x:Name="VolBtn" Grid.Column="3" Style="{StaticResource Transport}" ToolTip="Mute (M). Point at it for the volume slider">
            <fv:Glyph x:Name="VolIcon" Code="&#xE995;"/>
          </Button>
          <TextBlock x:Name="PosText" Grid.Column="4" FontSize="12" Margin="8,0,10,0" VerticalAlignment="Center" Text="00:00"/>
          <!-- A-B loop / trim part: a light capsule behind the time bar -->
          <Border x:Name="LoopRange" Grid.Column="5" Height="14" CornerRadius="7" VerticalAlignment="Center" HorizontalAlignment="Left"
                  Background="{DynamicResource LoopRangeFill}" BorderBrush="{DynamicResource LoopRangeEdge}" BorderThickness="1"
                  IsHitTestVisible="False" Visibility="Collapsed"/>
          <Slider x:Name="Seek" Grid.Column="5" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="1"/>
          <TextBlock x:Name="DurText" Grid.Column="6" FontSize="12" Margin="10,0,6,0" VerticalAlignment="Center" Text="00:00"/>
          <Button x:Name="LoopBtn" Grid.Column="7" Style="{StaticResource Transport}" ToolTip="Repeat (R)">
            <fv:Glyph x:Name="LoopIcon" Code="&#xE8EE;"/>
          </Button>
          <Button x:Name="VideoMoreBtn" Grid.Column="8" Style="{StaticResource Transport}" ToolTip="More options">
            <fv:Glyph Code="&#xE712;"/>
          </Button>
        </Grid>
      </Border>

      <!-- Opens on hover and closes itself (FastViewer.cs, InitVolumeHover), so it doesn't grab the mouse -->
      <Popup x:Name="VolPopup" PlacementTarget="{Binding ElementName=VolBtn}" Placement="Top" VerticalOffset="-8"
             StaysOpen="True" AllowsTransparency="True" PopupAnimation="None">
        <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Float}" Padding="6,4">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="MuteBtn" Style="{StaticResource Transport}" ToolTip="Mute (M)">
              <fv:Glyph x:Name="MuteIcon" Code="&#xE995;"/>
            </Button>
            <Slider x:Name="Vol" Style="{StaticResource FluentSlider}" Width="140" Minimum="0" Maximum="100" Margin="6,0"/>
            <TextBlock x:Name="VolText" Width="30" FontSize="13" Foreground="{DynamicResource TextMain}" FontFamily="{DynamicResource Font.Ui}"
                       VerticalAlignment="Center" TextAlignment="Right" Margin="2,0,8,0"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>

    <!-- Small message at the top (e.g. "Resumed at 2:31", save progress); doesn't fade with the controls -->
    <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"
            Background="{DynamicResource FloatBg}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Float}" Padding="14,6,6,6">
      <Grid>
      <!-- Saving a video: a thin line along the bottom fills as it goes -->
      <Rectangle x:Name="ToastProgress" Height="2" VerticalAlignment="Bottom" Margin="-12,0,-4,-5" Fill="{DynamicResource Accent}" Visibility="Collapsed" RadiusX="1" RadiusY="1">
        <Rectangle.RenderTransform><ScaleTransform ScaleX="0"/></Rectangle.RenderTransform>
      </Rectangle>
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="13"/>
        <Button x:Name="ToastBtn" Style="{StaticResource Filled}" Height="28" Margin="12,0,0,0" Visibility="Collapsed"/>
        <Button x:Name="ToastClose" Style="{StaticResource Subtle}" Height="28" MinWidth="28" Padding="6,0" Margin="4,0,0,0" ToolTip="Close">
          <fv:Glyph Code="&#xE711;" Size="10"/>
        </Button>
      </StackPanel>
      </Grid>
    </Border>

    <!-- Trim: a filmstrip of the video with two handles; the part between them is kept (Playback.cs, Trim.cs) -->
    <Border x:Name="TrimBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Width="640" Visibility="Collapsed"
            Background="{DynamicResource FloatBg}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Float}" Padding="14,10,14,8" AutomationProperties.Name="Trim">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="TrimPlayBtn" Style="{StaticResource Filled}" Height="30">
              <StackPanel Orientation="Horizontal">
                <fv:Glyph x:Name="TrimPlayIcon" Code="&#xE768;" Size="12" Margin="0,0,8,0"/>
                <TextBlock x:Name="TrimPlayText" Text="Play selection" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="TrimCancelBtn" Style="{StaticResource Subtle}" Height="30" Margin="6,0,0,0" Content="Cancel"/>
            <Button x:Name="TrimSaveBtn" Style="{StaticResource AccentButton}" Height="30" Margin="6,0,0,0" Content="Save clip"/>
          </StackPanel>
          <fv:Glyph Code="&#xE7A8;" Size="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="TrimText" FontSize="14" FontWeight="SemiBold" Text="Trim" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TrimHint" FontSize="12" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"
                       Text="Drag the handles to choose the part to keep"/>
          </StackPanel>
        </DockPanel>
        <!-- The filmstrip: the handles sit just outside the part they mark, the dimmed parts are cut off -->
        <Grid x:Name="TrimTrack" Grid.Row="1" Height="56" Margin="0,12,0,0" Background="Transparent">
          <Border x:Name="TrimFramesBox" Margin="14,4" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ThumbPlaceholder}">
            <UniformGrid x:Name="TrimFrames" Rows="1"/>
          </Border>
          <Canvas x:Name="TrimCanvas">
            <Rectangle x:Name="TrimDimLeft" Canvas.Top="4" Height="48" Fill="#A6000000"/>
            <Rectangle x:Name="TrimDimRight" Canvas.Top="4" Height="48" Fill="#A6000000"/>
            <Border x:Name="TrimSel" Height="56" BorderBrush="{DynamicResource Accent}" BorderThickness="0,3,0,3" IsHitTestVisible="False"/>
            <Border x:Name="TrimHead" Width="4" Height="64" Canvas.Top="-4" CornerRadius="2" Background="White" BorderBrush="#80000000" BorderThickness="1"
                    IsHitTestVisible="False"/>
            <Border x:Name="TrimHandleA" Width="14" Height="56" CornerRadius="6,0,0,6" Background="{DynamicResource Accent}" Cursor="SizeWE"
                    Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="Start of the clip"
                    AutomationProperties.HelpText="Drag, or use the left and right arrow keys (Shift: a second at a time)">
              <Rectangle Width="2" Height="18" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentText}" Opacity="0.85"/>
            </Border>
            <Border x:Name="TrimHandleB" Width="14" Height="56" CornerRadius="0,6,6,0" Background="{DynamicResource Accent}" Cursor="SizeWE"
                    Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="End of the clip"
                    AutomationProperties.HelpText="Drag, or use the left and right arrow keys (Shift: a second at a time)">
              <Rectangle Width="2" Height="18" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentText}" Opacity="0.85"/>
            </Border>
          </Canvas>
        </Grid>
        <!-- Start and end times under the handles -->
        <Canvas x:Name="TrimLabels" Grid.Row="2" Height="20" Margin="0,4,0,0" ClipToBounds="False">
          <TextBlock x:Name="TrimFromText" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="TrimToText" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        </Canvas>
      </Grid>
    </Border>

    <!-- File info pane -->
    <Border x:Name="InfoPanel" Grid.Column="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelEdge}" BorderThickness="1,0,0,0">
      <DockPanel Margin="20,14,10,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
          <TextBlock Text="Info" FontSize="20" FontFamily="{DynamicResource Font.Title}" FontWeight="{DynamicResource Weight.Title}" VerticalAlignment="Center"/>
          <Button x:Name="InfoCloseBtn" Style="{StaticResource Subtle}" HorizontalAlignment="Right" ToolTip="Close">
            <fv:Glyph Code="&#xE711;" Size="12"/>
          </Button>
        </Grid>
        <StackPanel x:Name="InfoList" Margin="0,0,10,0"/>
      </DockPanel>
    </Border>
  </Grid>

  <!-- Bottom: the thumbnail strip (when switched on in Settings) above the bar with the file details -->
  <Grid x:Name="BottomBar" Grid.Row="2" Background="{DynamicResource BottomBarBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="BottomControlsRow" Height="32"/>
    </Grid.RowDefinitions>
    <Canvas x:Name="Strip" Height="64" Background="{DynamicResource StripBg}" ClipToBounds="True" Visibility="Collapsed"/>
    <StackPanel x:Name="BottomLeft" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,0">
      <Button x:Name="SlideshowBtn" Style="{StaticResource Small}" Margin="0,0,2,0" ToolTip="Start slideshow (F5)">
        <fv:Glyph Code="&#xE786;" Size="14"/>
      </Button>
      <Button x:Name="GridBtn" Style="{StaticResource Small}" ToolTip="All files in this folder (G)">
        <fv:Glyph Code="&#xF0E2;" Size="14"/>
      </Button>
      <StackPanel x:Name="FileFacts" Orientation="Horizontal" Margin="10,0,0,0"
                  TextElement.FontSize="12" TextElement.Foreground="{DynamicResource TextSecondary}">
        <TextBlock x:Name="TypeText" VerticalAlignment="Center"/>
        <Rectangle Width="1" Height="14" Fill="{DynamicResource Divider}" Margin="10,0"/>
        <fv:Glyph Code="&#xE91B;" Size="13"/>
        <TextBlock x:Name="DimText" Margin="7,0,0,0" VerticalAlignment="Center"/>
        <Rectangle Width="1" Height="14" Fill="{DynamicResource Divider}" Margin="10,0"/>
        <fv:Glyph Code="&#xE74E;" Size="13"/>
        <TextBlock x:Name="SizeText" Margin="7,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <Button x:Name="InfoBtn" Grid.Row="1" Style="{StaticResource Small}" HorizontalAlignment="Center" ToolTip="File info (I)">
      <fv:Glyph Code="&#xE946;" Size="14"/>
    </Button>

    <StackPanel x:Name="BottomRight" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
      <Button x:Name="FitBtn" Style="{StaticResource Small}" Margin="0,0,6,0" ToolTip="Fit to window (0)">
        <fv:Glyph Code="&#xE9A6;" Size="14"/>
      </Button>
      <Button x:Name="ZoomBtn" Style="{StaticResource FilledSmall}" Width="80" Margin="0,0,6,0" HorizontalContentAlignment="Stretch" ToolTip="Zoom">
        <Grid>
          <TextBlock x:Name="ZoomText" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <fv:Glyph Code="&#xE70D;" Size="9" HorizontalAlignment="Right"/>
        </Grid>
      </Button>
      <StackPanel x:Name="ZoomGroup" Orientation="Horizontal">
        <Button x:Name="ZoomOutBtn" Style="{StaticResource Small}" ToolTip="Zoom out (-)">
          <fv:Glyph Code="&#xE71F;" Size="14"/>
        </Button>
        <Slider x:Name="ZoomSlider" Style="{StaticResource FluentSlider}" Width="130" Margin="2,0"/>
        <Button x:Name="ZoomInBtn" Style="{StaticResource Small}" ToolTip="Zoom in (+)">
          <fv:Glyph Code="&#xE8A3;" Size="14"/>
        </Button>
      </StackPanel>
      <Rectangle x:Name="ZoomDivider" Width="1" Height="16" Fill="{DynamicResource Divider}" Margin="8,0"/>
      <Button x:Name="FullBtn" Style="{StaticResource Small}" ToolTip="Full screen (F11)">
        <fv:Glyph x:Name="FullIcon" Code="&#xE740;" Size="14"/>
      </Button>
    </StackPanel>
  </Grid>

  <!-- Folder grid: every photo and video in the folder (tiles are added in code). Above the floating
       full-screen bars, so it fills the whole screen there. -->
  <Grid x:Name="GridPage" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource PageBg}" Visibility="Collapsed" Panel.ZIndex="11">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="12,10,16,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="GridBackBtn" Style="{StaticResource Subtle}" ToolTip="Back (Esc)">
          <fv:Glyph Code="&#xE72B;"/>
        </Button>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0" TextTrimming="CharacterEllipsis">
          <Run x:Name="GridFolder" FontSize="20" FontFamily="{DynamicResource Font.Title}" FontWeight="{DynamicResource Weight.Title}"/><Run x:Name="GridCount" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
        </TextBlock>
        <Button x:Name="GridNamesBtn" Grid.Column="2" Style="{StaticResource Filled}" Height="32" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <fv:Glyph x:Name="GridNamesIcon" Code="&#xE73E;" Size="12" Margin="0,0,8,0"/>
            <TextBlock Text="Names" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="GridSizeBtn" Grid.Column="3" Style="{StaticResource Filled}" Height="32" ToolTip="Thumbnail size (Ctrl + mouse wheel)">
          <StackPanel Orientation="Horizontal">
            <fv:Glyph Code="&#xF0E2;" Size="14"/>
            <TextBlock x:Name="GridSizeText" Margin="10,0,14,0" VerticalAlignment="Center"/>
            <fv:Glyph Code="&#xE70D;" Size="10"/>
          </StackPanel>
        </Button>
      </Grid>
      <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Canvas x:Name="GridCanvas" Margin="16,4,16,16" VerticalAlignment="Top"/>
      </ScrollViewer>
    </DockPanel>
  </Grid>

  <!-- Settings page (cards are added in code) -->
  <Grid x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource PageBg}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SettingsNavCol" Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <!-- Side menu: always visible, so Back never scrolls away -->
    <DockPanel Margin="12,14,6,14">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
        <Button x:Name="SettingsBackBtn" Style="{StaticResource Subtle}" ToolTip="Back (Esc)">
          <fv:Glyph Code="&#xE72B;"/>
        </Button>
        <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="20" FontFamily="{DynamicResource Font.Title}" FontWeight="{DynamicResource Weight.Title}"
                   VerticalAlignment="Center" Margin="10,0,0,0"/>
      </StackPanel>
      <!-- Scrolls in short windows, so every page stays reachable -->
      <ScrollViewer x:Name="SettingsNavScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid>
          <!-- Liquid Glass: a glass "lens" slides behind the chosen page -->
          <Border x:Name="SettingsLens" Background="{DynamicResource LensBg}" BorderBrush="{DynamicResource LensEdge}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Control}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0"/>
          <StackPanel x:Name="SettingsNav"/>
        </Grid>
      </ScrollViewer>
    </DockPanel>
    <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel x:Name="SettingsList" MaxWidth="900" Margin="20,18,36,40"/>
    </ScrollViewer>
  </Grid>
  <!-- Dragging a file over the window -->
  <Border x:Name="DropOutline" Grid.RowSpan="3" Margin="8" BorderThickness="2" BorderBrush="{DynamicResource Accent}" CornerRadius="10"
          IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="1500" RenderTransformOrigin="0.5,0.5"/>
  <!-- Delete confirmation, styled like a Windows content dialog -->
  <Grid x:Name="Dialog" Grid.RowSpan="3" Background="{DynamicResource DialogShade}" Visibility="Collapsed">
    <!-- 440 wide, narrower in a small window (the text wraps) -->
    <Border MaxWidth="440" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource DialogBg}"
            BorderBrush="{DynamicResource DialogEdge}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Dialog}">
      <StackPanel>
        <StackPanel Margin="24">
          <TextBlock Text="Delete this file?" FontSize="20" FontFamily="{DynamicResource Font.Title}" FontWeight="{DynamicResource Weight.Title}"/>
          <TextBlock x:Name="DialogText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
        <Border Background="{DynamicResource DialogFooter}" CornerRadius="{DynamicResource Radius.DialogFooter}" Padding="24"
                BorderBrush="{DynamicResource DialogEdge}" BorderThickness="0,1,0,0">
          <UniformGrid Columns="2">
            <Button x:Name="DialogOk" Style="{StaticResource AccentButton}" Height="32" Margin="0,0,4,0" Content="Delete"/>
            <Button x:Name="DialogCancel" Style="{StaticResource Filled}" Height="32" Margin="4,0,0,0" Content="Cancel"/>
          </UniformGrid>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
