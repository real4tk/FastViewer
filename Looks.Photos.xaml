<!-- Look "Photos": the Windows 11 Photos app (the default; dark is FastViewer's original look).
     Every look defines the same keys: "Dark.X" / "Light.X" colours and the shared values below them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:String x:Key="Look.Name">Photos</sys:String>
  <sys:String x:Key="Look.Description">Like the Windows 11 Photos app.</sys:String>
  <sys:Int32 x:Key="Look.Order">1</sys:Int32>
  <sys:Boolean x:Key="Look.HasLight">True</sys:Boolean>
  <sys:String x:Key="Look.Icons">Segoe</sys:String>
  <sys:Double x:Key="Look.IconStroke">1.5</sys:Double>
  <sys:Boolean x:Key="Look.BarsFloat">False</sys:Boolean>
  <sys:Boolean x:Key="Look.SeeThrough">False</sys:Boolean>
  <sys:Boolean x:Key="Look.Spring">False</sys:Boolean>
  <sys:Double x:Key="Motion.FadeIn">120</sys:Double>
  <sys:Double x:Key="Motion.FadeOut">300</sys:Double>
  <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Title">Segoe UI</FontFamily>
  <FontWeight x:Key="Weight.Title">SemiBold</FontWeight>
  <sys:Double x:Key="Size.PageTitle">28</sys:Double>
  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Radius.Float">8</CornerRadius>
  <CornerRadius x:Key="Radius.Card">4</CornerRadius>
  <CornerRadius x:Key="Radius.Center">8</CornerRadius>
  <CornerRadius x:Key="Radius.Dialog">8</CornerRadius>
  <CornerRadius x:Key="Radius.DialogFooter">0,0,8,8</CornerRadius>
  <sys:Double x:Key="Radius.Window">0</sys:Double>

  <!-- Dark -->
  <SolidColorBrush x:Key="Dark.WindowBg" Color="#202020"/>
  <SolidColorBrush x:Key="Dark.StageBg" Color="#202020"/>
  <SolidColorBrush x:Key="Dark.CoverBg" Color="#202020"/>
  <SolidColorBrush x:Key="Dark.FullBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.TopBarBg" Color="#202020"/>
  <SolidColorBrush x:Key="Dark.BottomBarBg" Color="#272727"/>
  <SolidColorBrush x:Key="Dark.StripBg" Color="#202020"/>
  <SolidColorBrush x:Key="Dark.PanelBg" Color="#272727"/>
  <SolidColorBrush x:Key="Dark.PanelEdge" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="Dark.PageBg" Color="#202020"/>
  <SolidColorBrush x:Key="Dark.CardBg" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="Dark.CardEdge" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="Dark.NavSelected" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="Dark.TextMain" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Dark.TextSecondary" Color="#C5C5C5"/>
  <SolidColorBrush x:Key="Dark.TextDim" Color="#9D9D9D"/>
  <SolidColorBrush x:Key="Dark.Divider" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="Dark.HoverFill" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="Dark.ControlFill" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="Dark.ControlEdge" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="Dark.ControlText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Dark.ControlHoverText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Dark.FloatBg" Color="#F22C2C2C"/>
  <SolidColorBrush x:Key="Dark.FloatEdge" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="Dark.MenuBg" Color="#2C2C2C"/>
  <SolidColorBrush x:Key="Dark.MenuHover" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="Dark.MenuEdge" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="Dark.TipBg" Color="#2C2C2C"/>
  <SolidColorBrush x:Key="Dark.TipEdge" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="Dark.ArrowBg" Color="#F02B2B2B"/>
  <SolidColorBrush x:Key="Dark.ArrowEdge" Color="#17FFFFFF"/>
  <SolidColorBrush x:Key="Dark.CenterBg" Color="#17FFFFFF"/>
  <SolidColorBrush x:Key="Dark.CenterHover" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="Dark.CenterEdge" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="Dark.SwitchTrack" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="Dark.SwitchEdge" Color="#9AFFFFFF"/>
  <SolidColorBrush x:Key="Dark.SwitchKnob" Color="#D0D0D0"/>
  <SolidColorBrush x:Key="Dark.SwitchKnobOn" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.SliderRestFill" Color="#8BFFFFFF"/>
  <SolidColorBrush x:Key="Dark.SliderThumbBg" Color="#454545"/>
  <SolidColorBrush x:Key="Dark.SliderThumbEdge" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="Dark.ScrollThumb" Color="#8BFFFFFF"/>
  <SolidColorBrush x:Key="Dark.CaptionHover" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="Dark.CloseHover" Color="#C42B1C"/>
  <SolidColorBrush x:Key="Dark.AccentText" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.ScrimFill" Color="#4D000000"/>
  <SolidColorBrush x:Key="Dark.DialogShade" Color="#99000000"/>
  <SolidColorBrush x:Key="Dark.DialogBg" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="Dark.DialogEdge" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="Dark.DialogFooter" Color="#202020"/>
  <SolidColorBrush x:Key="Dark.ThumbPlaceholder" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="Dark.ThumbHover" Color="#5AFFFFFF"/>
  <SolidColorBrush x:Key="Dark.BadgeBg" Color="#A01C1C1C"/>
  <SolidColorBrush x:Key="Dark.LoopRangeFill" Color="#55FFFFFF"/>
  <SolidColorBrush x:Key="Dark.LoopRangeEdge" Color="#99FFFFFF"/>
  <SolidColorBrush x:Key="Dark.LensBg" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="Dark.LensEdge" Color="Transparent"/>

  <!-- Light -->
  <SolidColorBrush x:Key="Light.WindowBg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Light.StageBg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Light.CoverBg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Light.FullBg" Color="#000000"/>
  <SolidColorBrush x:Key="Light.TopBarBg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Light.BottomBarBg" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="Light.StripBg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Light.PanelBg" Color="#F9F9F9"/>
  <SolidColorBrush x:Key="Light.PanelEdge" Color="#14000000"/>
  <SolidColorBrush x:Key="Light.PageBg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Light.CardBg" Color="#FBFBFB"/>
  <SolidColorBrush x:Key="Light.CardEdge" Color="#14000000"/>
  <SolidColorBrush x:Key="Light.NavSelected" Color="#0A000000"/>
  <SolidColorBrush x:Key="Light.TextMain" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="Light.TextSecondary" Color="#5D5D5D"/>
  <SolidColorBrush x:Key="Light.TextDim" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="Light.Divider" Color="#D6D6D6"/>
  <SolidColorBrush x:Key="Light.HoverFill" Color="#0A000000"/>
  <SolidColorBrush x:Key="Light.ControlFill" Color="#B3FFFFFF"/>
  <SolidColorBrush x:Key="Light.ControlEdge" Color="#14000000"/>
  <SolidColorBrush x:Key="Light.ControlText" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="Light.ControlHoverText" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="Light.FloatBg" Color="#F5FBFBFB"/>
  <SolidColorBrush x:Key="Light.FloatEdge" Color="#14000000"/>
  <SolidColorBrush x:Key="Light.MenuBg" Color="#F9F9F9"/>
  <SolidColorBrush x:Key="Light.MenuHover" Color="#0A000000"/>
  <SolidColorBrush x:Key="Light.MenuEdge" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="Light.TipBg" Color="#F9F9F9"/>
  <SolidColorBrush x:Key="Light.TipEdge" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="Light.ArrowBg" Color="#F0FBFBFB"/>
  <SolidColorBrush x:Key="Light.ArrowEdge" Color="#14000000"/>
  <SolidColorBrush x:Key="Light.CenterBg" Color="#17FFFFFF"/>
  <SolidColorBrush x:Key="Light.CenterHover" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="Light.CenterEdge" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="Light.SwitchTrack" Color="#0A000000"/>
  <SolidColorBrush x:Key="Light.SwitchEdge" Color="#9A000000"/>
  <SolidColorBrush x:Key="Light.SwitchKnob" Color="#5A5A5A"/>
  <SolidColorBrush x:Key="Light.SwitchKnobOn" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.SliderRestFill" Color="#8B000000"/>
  <SolidColorBrush x:Key="Light.SliderThumbBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.SliderThumbEdge" Color="#24000000"/>
  <SolidColorBrush x:Key="Light.ScrollThumb" Color="#8B000000"/>
  <SolidColorBrush x:Key="Light.CaptionHover" Color="#0F000000"/>
  <SolidColorBrush x:Key="Light.CloseHover" Color="#C42B1C"/>
  <SolidColorBrush x:Key="Light.AccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.ScrimFill" Color="#33000000"/>
  <SolidColorBrush x:Key="Light.DialogShade" Color="#66000000"/>
  <SolidColorBrush x:Key="Light.DialogBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.DialogEdge" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="Light.DialogFooter" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Light.ThumbPlaceholder" Color="#E3E3E3"/>
  <SolidColorBrush x:Key="Light.ThumbHover" Color="#66000000"/>
  <SolidColorBrush x:Key="Light.BadgeBg" Color="#A01C1C1C"/>
  <SolidColorBrush x:Key="Light.LoopRangeFill" Color="#40000000"/>
  <SolidColorBrush x:Key="Light.LoopRangeEdge" Color="#80000000"/>
  <SolidColorBrush x:Key="Light.LensBg" Color="#0A000000"/>
  <SolidColorBrush x:Key="Light.LensEdge" Color="Transparent"/>
</ResourceDictionary>
