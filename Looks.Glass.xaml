<!-- Look "Liquid Glass": the Apple-style look of Image Converter. The window is see-through and Windows blurs
     whatever is behind it (Look.SeeThrough); bars, panels and cards are frosted glass with a bright rim, a deeper
     tint sits behind the photo, a glass lens slides behind the chosen item, motion uses springs, icons are
     SF Symbols-style lines (Icons.Lines.xaml), and the font is Inter (SF Pro when it's installed). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:String x:Key="Look.Name">Liquid Glass</sys:String>
  <sys:String x:Key="Look.Description">Frosted glass over your blurred desktop. Springy motion.</sys:String>
  <sys:Int32 x:Key="Look.Order">3</sys:Int32>
  <sys:Boolean x:Key="Look.HasLight">True</sys:Boolean>
  <sys:String x:Key="Look.Icons">Lines</sys:String>
  <sys:Double x:Key="Look.IconStroke">1.6</sys:Double>
  <sys:Boolean x:Key="Look.BarsFloat">False</sys:Boolean>
  <sys:Boolean x:Key="Look.SeeThrough">True</sys:Boolean>
  <sys:Boolean x:Key="Look.Spring">True</sys:Boolean>
  <sys:Double x:Key="Motion.FadeIn">180</sys:Double>
  <sys:Double x:Key="Motion.FadeOut">380</sys:Double>
  <!-- Motion (Motion.cs): springy: a little overshoot that settles, buttons press in -->
  <sys:Double x:Key="Motion.Fast">180</sys:Double>
  <sys:Double x:Key="Motion.Normal">280</sys:Double>
  <sys:Double x:Key="Motion.Slow">380</sys:Double>
  <sys:String x:Key="Motion.Ease">spring</sys:String>
  <sys:Double x:Key="Motion.Distance">1.2</sys:Double>
  <sys:Double x:Key="Motion.Press">0.95</sys:Double>
  <sys:Boolean x:Key="Motion.Squish">True</sys:Boolean>
  <sys:String x:Key="Font.Ui">@Inter</sys:String>
  <sys:String x:Key="Font.Title">@Inter Display</sys:String>
  <FontWeight x:Key="Weight.Title">SemiBold</FontWeight>
  <sys:Double x:Key="Size.PageTitle">30</sys:Double>
  <CornerRadius x:Key="Radius.Control">10</CornerRadius>
  <CornerRadius x:Key="Radius.Float">18</CornerRadius>
  <CornerRadius x:Key="Radius.Card">16</CornerRadius>
  <CornerRadius x:Key="Radius.Center">40</CornerRadius>
  <CornerRadius x:Key="Radius.Dialog">22</CornerRadius>
  <CornerRadius x:Key="Radius.DialogFooter">0,0,22,22</CornerRadius>
  <sys:Double x:Key="Radius.Window">12</sys:Double>

