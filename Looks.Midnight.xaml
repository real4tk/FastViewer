<!-- Look "Midnight": like the Currency Converter app. Pure black (or pure white), no boxes, no shadows, no rounded
     corners; controls are dim grey and turn full white on hover; thin large titles. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:String x:Key="Look.Name">Midnight</sys:String>
  <sys:String x:Key="Look.Description">Pure black, no boxes, thin text. Or pure white.</sys:String>
  <sys:Int32 x:Key="Look.Order">4</sys:Int32>
  <sys:Boolean x:Key="Look.HasLight">True</sys:Boolean>
  <sys:String x:Key="Look.Icons">Segoe</sys:String>
  <sys:Double x:Key="Look.IconStroke">1.4</sys:Double>
  <sys:Boolean x:Key="Look.BarsFloat">False</sys:Boolean>
  <sys:Boolean x:Key="Look.SeeThrough">False</sys:Boolean>
  <sys:Boolean x:Key="Look.Spring">False</sys:Boolean>
  <sys:Double x:Key="Motion.FadeIn">90</sys:Double>
  <sys:Double x:Key="Motion.FadeOut">200</sys:Double>
  <!-- Motion (Motion.cs): calm and minimal: mostly fades, barely any movement -->
  <sys:Double x:Key="Motion.Fast">150</sys:Double>
  <sys:Double x:Key="Motion.Normal">220</sys:Double>
  <sys:Double x:Key="Motion.Slow">300</sys:Double>
  <sys:String x:Key="Motion.Ease">calm</sys:String>
  <sys:Double x:Key="Motion.Distance">0.4</sys:Double>
  <sys:Double x:Key="Motion.Press">1</sys:Double>
  <sys:Boolean x:Key="Motion.Squish">False</sys:Boolean>
  <sys:String x:Key="Font.Ui">@Inter</sys:String>
  <FontFamily x:Key="Font.Title">Segoe UI Light</FontFamily>
  <FontWeight x:Key="Weight.Title">Light</FontWeight>
  <sys:Double x:Key="Size.PageTitle">36</sys:Double>
  <CornerRadius x:Key="Radius.Control">0</CornerRadius>
  <CornerRadius x:Key="Radius.Float">0</CornerRadius>
  <CornerRadius x:Key="Radius.Card">0</CornerRadius>
  <CornerRadius x:Key="Radius.Center">0</CornerRadius>
  <CornerRadius x:Key="Radius.Dialog">0</CornerRadius>
  <CornerRadius x:Key="Radius.DialogFooter">0</CornerRadius>
  <sys:Double x:Key="Radius.Window">0</sys:Double>

  <!-- Dark: pure black -->
  <SolidColorBrush x:Key="Dark.WindowBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.StageBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.CoverBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.FullBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.TopBarBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.BottomBarBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.StripBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.PanelBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.PanelEdge" Color="#1F1F1F"/>
  <SolidColorBrush x:Key="Dark.PageBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.CardBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.CardEdge" Color="#141414"/>
  <SolidColorBrush x:Key="Dark.NavSelected" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.TextMain" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Dark.TextSecondary" Color="#8C8C8C"/>
  <SolidColorBrush x:Key="Dark.TextDim" Color="#7A7A7A"/>
  <SolidColorBrush x:Key="Dark.Divider" Color="#1F1F1F"/>
  <SolidColorBrush x:Key="Dark.HoverFill" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.ControlFill" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.ControlEdge" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.ControlText" Color="#7A7A7A"/>
  <SolidColorBrush x:Key="Dark.ControlHoverText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Dark.FloatBg" Color="#E6000000"/>
  <SolidColorBrush x:Key="Dark.FloatEdge" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.MenuBg" Color="#0A0A0A"/>
  <SolidColorBrush x:Key="Dark.MenuHover" Color="#141414"/>
  <SolidColorBrush x:Key="Dark.MenuEdge" Color="#262626"/>
  <SolidColorBrush x:Key="Dark.TipBg" Color="#111111"/>
  <SolidColorBrush x:Key="Dark.TipEdge" Color="#333333"/>
  <SolidColorBrush x:Key="Dark.ArrowBg" Color="#80000000"/>
  <SolidColorBrush x:Key="Dark.ArrowEdge" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.CenterBg" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.CenterHover" Color="#26000000"/>
  <SolidColorBrush x:Key="Dark.CenterEdge" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.SwitchTrack" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.SwitchEdge" Color="#555555"/>
  <SolidColorBrush x:Key="Dark.SwitchKnob" Color="#7A7A7A"/>
  <SolidColorBrush x:Key="Dark.SwitchKnobOn" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.SliderRestFill" Color="#333333"/>
  <SolidColorBrush x:Key="Dark.SliderThumbBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.SliderThumbEdge" Color="#555555"/>
  <SolidColorBrush x:Key="Dark.ScrollThumb" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="Dark.CaptionHover" Color="#141414"/>
  <SolidColorBrush x:Key="Dark.CloseHover" Color="#C42B1C"/>
  <SolidColorBrush x:Key="Dark.Accent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Dark.AccentText" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.ScrimFill" Color="#33000000"/>
  <SolidColorBrush x:Key="Dark.DialogShade" Color="#CC000000"/>
  <SolidColorBrush x:Key="Dark.DialogBg" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.DialogEdge" Color="#333333"/>
  <SolidColorBrush x:Key="Dark.DialogFooter" Color="#000000"/>
  <SolidColorBrush x:Key="Dark.ThumbPlaceholder" Color="#111111"/>
  <SolidColorBrush x:Key="Dark.ThumbHover" Color="#7A7A7A"/>
  <SolidColorBrush x:Key="Dark.BadgeBg" Color="#B3000000"/>
  <SolidColorBrush x:Key="Dark.LoopRangeFill" Color="#33FFFFFF"/>
  <SolidColorBrush x:Key="Dark.LoopRangeEdge" Color="#80FFFFFF"/>
  <SolidColorBrush x:Key="Dark.LensBg" Color="Transparent"/>
  <SolidColorBrush x:Key="Dark.LensEdge" Color="Transparent"/>

  <!-- Light: pure white -->
  <SolidColorBrush x:Key="Light.WindowBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.StageBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.CoverBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.FullBg" Color="#000000"/>
  <SolidColorBrush x:Key="Light.TopBarBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.BottomBarBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.StripBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.PanelBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.PanelEdge" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="Light.PageBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.CardBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.CardEdge" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Light.NavSelected" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.TextMain" Color="#000000"/>
  <SolidColorBrush x:Key="Light.TextSecondary" Color="#6A6A6A"/>
  <SolidColorBrush x:Key="Light.TextDim" Color="#767676"/>
  <SolidColorBrush x:Key="Light.Divider" Color="#EDEDED"/>
  <SolidColorBrush x:Key="Light.HoverFill" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.ControlFill" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.ControlEdge" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.ControlText" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="Light.ControlHoverText" Color="#000000"/>
  <SolidColorBrush x:Key="Light.FloatBg" Color="#E6FFFFFF"/>
  <SolidColorBrush x:Key="Light.FloatEdge" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.MenuBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.MenuHover" Color="#F2F2F2"/>
  <SolidColorBrush x:Key="Light.MenuEdge" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="Light.TipBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.TipEdge" Color="#CCCCCC"/>
  <SolidColorBrush x:Key="Light.ArrowBg" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.ArrowEdge" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.CenterBg" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.CenterHover" Color="#26000000"/>
  <SolidColorBrush x:Key="Light.CenterEdge" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.SwitchTrack" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.SwitchEdge" Color="#AAAAAA"/>
  <SolidColorBrush x:Key="Light.SwitchKnob" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="Light.SwitchKnobOn" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.SliderRestFill" Color="#DDDDDD"/>
  <SolidColorBrush x:Key="Light.SliderThumbBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.SliderThumbEdge" Color="#AAAAAA"/>
  <SolidColorBrush x:Key="Light.ScrollThumb" Color="#CCCCCC"/>
  <SolidColorBrush x:Key="Light.CaptionHover" Color="#F2F2F2"/>
  <SolidColorBrush x:Key="Light.CloseHover" Color="#C42B1C"/>
  <SolidColorBrush x:Key="Light.Accent" Color="#000000"/>
  <SolidColorBrush x:Key="Light.AccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.ScrimFill" Color="#26000000"/>
  <SolidColorBrush x:Key="Light.DialogShade" Color="#CCFFFFFF"/>
  <SolidColorBrush x:Key="Light.DialogBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.DialogEdge" Color="#CCCCCC"/>
  <SolidColorBrush x:Key="Light.DialogFooter" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Light.ThumbPlaceholder" Color="#F2F2F2"/>
  <SolidColorBrush x:Key="Light.ThumbHover" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="Light.BadgeBg" Color="#B3000000"/>
  <SolidColorBrush x:Key="Light.LoopRangeFill" Color="#26000000"/>
  <SolidColorBrush x:Key="Light.LoopRangeEdge" Color="#66000000"/>
  <SolidColorBrush x:Key="Light.LensBg" Color="Transparent"/>
  <SolidColorBrush x:Key="Light.LensEdge" Color="Transparent"/>
</ResourceDictionary>
